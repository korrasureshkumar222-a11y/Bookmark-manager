PORT=5000
MONGO_URI=mongodb://localhost:27017/bookmark-manager
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Required app secrets
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_long_random_string

# Optional compatibility aliases used by the app
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
